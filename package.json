{
  "name": "dsm-creatures",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "RPG_TYPE=mmorpg vite --host",
    "build": "RPG_TYPE=mmorpg vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "proto:gen": "protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=import_extension=.js:./src/integrations/dsm/proto --es_opt=target=ts -I ${DSM_PROTO_DIR:-../dsm/proto} ${DSM_PROTO_DIR:-../dsm/proto}/dsm_app.proto",
    "art:pack-walks": "node scripts/pack-character-walks.mjs",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "start": "node scripts/server.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@canvasengine/compiler": "2.4.0",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "path-browserify": "^1.0.1",
    "pngjs": "5.0.0",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "private": true,
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@canvasengine/presets": "2.4.0",
    "@rpgjs/action-battle": "5.0.0",
    "@rpgjs/client": "5.0.0",
    "@rpgjs/common": "5.0.0",
    "@rpgjs/server": "5.0.0",
    "@rpgjs/tiledmap": "5.0.0",
    "@rpgjs/ui-css": "5.0.0",
    "@rpgjs/vite": "5.0.0",
    "@rpgjs/vue": "^5.0.0",
    "@signe/di": "^3.1.1",
    "canvasengine": "2.4.0",
    "pixi.js": "^8.21.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "type": "module"
}
