# Local development only; production must reach the existing DSM account host.
DSM_APP_HOST=http://127.0.0.1:8787
# For public Android builds, set the actual Vercel HTTPS URL. No LAN fallback is used for release.
# WILDSTATE_GAME_URL=https://your-game-project.vercel.app/
# Signing secrets are configured outside source control; see docs/android-app.md.

# Public browser endpoint for the persistent fleet RPG backend. No secrets here.
# VITE_GAME_HOST=wildstate.34.58.75.224.sslip.io
# Production backend only (never VITE_ variables):
# WILDSTATE_DATA_DIR=/data
# WILDSTATE_ALLOWED_ORIGINS=https://wildstate-dsm.vercel.app
# RPGJS_MAP_UPDATE_TOKEN=<private deployment secret>
